# Copy to .env.local for development. Set the same keys in Vercel > Project > Settings > Environment Variables.

# Where pitch and contact submissions are delivered.
NOTIFY_TO=contactuncfund@gmail.com

# Resend (https://resend.com). Without a key, submissions are logged to the server console instead of emailed.
RESEND_API_KEY=
# The sender. Until unc.fund is verified in Resend, "Unc <onboarding@resend.dev>" works but only delivers to the Resend account owner's address.
RESEND_FROM="Unc <unc@unc.fund>"

# Vercel Blob (Storage tab in the Vercel project). Without a token, deck files are not stored and the email says so.
BLOB_READ_WRITE_TOKEN=

# Public site URL, used in emails and metadata.
NEXT_PUBLIC_SITE_URL=https://unc.fund
